SERVICE_HOST=127.0.0.1
AGENT_PORT=3041
ROOMS_AGENT_DATA=/var/lib/rooms-agent
ROOMS_AGENT_AUTH_FILE=/etc/rooms-agent/auth.json
ROOMS_AGENT_POLICY_FILE=/etc/rooms-agent/policy.json
ROOMS_AGENT_STORAGE_KEY=REPLACE_WITH_PERSISTENT_64_HEX_CHARACTER_KEY
ROOMS_AGENT_WORKER_IMAGE=rooms-agent-worker:local
# Keep worker networking disabled until the dedicated host egress gates are accepted.
ROOMS_AGENT_WORKER_NETWORK=disabled
# Optional after dedicated bot accounts are supplied:
# ROOMS_AGENT_CONNECTORS_FILE=/etc/rooms-agent/connectors.json
# ROOMS_STOAT_BOT_URL=https://community.example.invalid
# ROOMS_STOAT_BOT_TOKEN=PROVISION_PRIVATELY
# ROOMS_STOAT_BOT_MAPPING_FILE=/etc/rooms-agent/stoat-mapping.json
# ROOMS_DISCORD_BOT_TOKEN=PROVISION_PRIVATELY
# ROOMS_DISCORD_BOT_ID=PROVISION_PRIVATELY
# ROOMS_DISCORD_MAPPING_FILE=/etc/rooms-agent/discord-mapping.json
