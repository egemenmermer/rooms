#!/usr/bin/env bash
# ROOMS self-hosting command. Run as root on the server, e.g. `rooms status`.
set -euo pipefail
umask 077

DEPLOY_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
REPO_DIR="$(dirname "$DEPLOY_DIR")"
ENV_FILE="$DEPLOY_DIR/.env"
CONFIG_DIR="$DEPLOY_DIR/config"
DATA_DIR="$DEPLOY_DIR/data"

bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
ok() { printf '\033[32m✔\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[31m✘\033[0m %s\n' "$*" >&2
  exit 1
}

compose() { docker compose --project-directory "$DEPLOY_DIR" -f "$DEPLOY_DIR/compose.yml" "$@"; }
env_value() { { grep -E "^$1=" "$ENV_FILE" 2>/dev/null || true; } | tail -1 | cut -d= -f2-; }
require_setup() { [[ -f "$ENV_FILE" ]] || die "Önce kurulum yap: rooms setup"; }
secret() { openssl rand -hex 32; }

ask() {
  local prompt="$1" default="${2:-}" answer
  if [[ -n "$default" ]]; then
    read -r -p "  $prompt [$default]: " answer </dev/tty || true
    printf '%s' "${answer:-$default}"
  else
    read -r -p "  $prompt: " answer </dev/tty || true
    printf '%s' "$answer"
  fi
}

detect_public_ip() {
  local ip
  for url in https://api.ipify.org https://ifconfig.me/ip https://icanhazip.com; do
    ip="$(curl -4 -fsS --max-time 5 "$url" 2>/dev/null | tr -d '[:space:]')" || true
    [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] && {
      printf '%s' "$ip"
      return
    }
  done
}

resolve_domain() { getent ahostsv4 "$1" 2>/dev/null | awk 'NR==1{print $1}'; }

cmd_setup() {
  [[ -f "$ENV_FILE" ]] && die "Kurulum zaten yapılmış ($ENV_FILE). Mevcut sırlar korunuyor."
  command -v docker >/dev/null || die "Docker bulunamadı."
  command -v openssl >/dev/null || die "openssl bulunamadı."

  bold "ROOMS sunucu kurulumu"
  local ip domain email duck_token
  ip="${ROOMS_PUBLIC_IP:-$(detect_public_ip)}"
  [[ -n "$ip" ]] || ip="$(ask 'Sunucunun genel IPv4 adresi')"
  info "Genel IP: $ip"
  echo
  info "Üyeler sunucuya bir alan adıyla bağlanır (örnek: sohbet.ornek.com)."
  info "Alan adın yoksa duckdns.org'dan ücretsiz bir ad alabilirsin (örnek: arkadaslar.duckdns.org)."
  domain="${ROOMS_DOMAIN:-$(ask 'Alan adı')}"
  domain="$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]' | sed -E 's#^https?://##; s#/.*$##')"
  [[ "$domain" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?\.[a-z]{2,}$ ]] || die "Geçersiz alan adı: $domain"

  if [[ "$domain" == *.duckdns.org ]]; then
    duck_token="${ROOMS_DUCKDNS_TOKEN:-$(ask 'DuckDNS token (duckdns.org sayfanın üstünde)')}"
    local sub="${domain%.duckdns.org}"
    if [[ "$(curl -fsS --max-time 10 "https://www.duckdns.org/update?domains=${sub}&token=${duck_token}&ip=${ip}" || true)" == OK* ]]; then
      ok "DuckDNS kaydı $ip adresine yönlendirildi."
    else
      warn "DuckDNS güncellenemedi; adı ve token'ı duckdns.org'da kontrol et."
    fi
  fi

  local resolved
  resolved="$(resolve_domain "$domain" || true)"
  if [[ "$resolved" != "$ip" ]]; then
    warn "$domain şu an '${resolved:-çözülemiyor}' adresine gidiyor, $ip değil."
    warn "Alan adının A kaydını $ip yap. HTTPS sertifikası ancak bundan sonra alınabilir."
  else
    ok "$domain → $ip"
  fi

  email="${ROOMS_ACME_EMAIL:-$(ask 'Sertifika bildirimleri için e-posta')}"
  [[ "$email" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]] || die "Geçersiz e-posta."

  mkdir -p "$CONFIG_DIR" "$DATA_DIR"/{db,rabbit,minio,postgres,access,caddy-data,caddy-config}
  chmod 700 "$CONFIG_DIR" "$DATA_DIR"

  local mongo_stoat livekit_key livekit_secret
  mongo_stoat="$(secret)"
  livekit_key="rooms-$(openssl rand -hex 12)"
  livekit_secret="$(secret)"
  cat >"$ENV_FILE" <<EOF
# Generated by \`rooms setup\`. Keep private; back up together with ./data.
ROOMS_DOMAIN=$domain
ROOMS_PUBLIC_IP=$ip
ROOMS_ACME_EMAIL=$email
MONGO_ROOT_PASSWORD=$(secret)
MONGO_STOAT_PASSWORD=$mongo_stoat
MONGO_INVITER_PASSWORD=$(secret)
MONGO_READER_PASSWORD=$(secret)
RABBIT_PASSWORD=$(secret)
MINIO_PASSWORD=$(secret)
POSTGRES_PASSWORD=$(secret)
LIVEKIT_API_KEY=$livekit_key
LIVEKIT_API_SECRET=$livekit_secret
EOF
  [[ -n "${duck_token:-}" ]] && printf 'ROOMS_DUCKDNS_TOKEN=%s\n' "$duck_token" >>"$ENV_FILE"

  # Upstream Stoat configuration (unmodified images, deployment-owned values).
  local vapid_private vapid_public
  vapid_private="$(openssl ecparam -name prime256v1 -genkey -noout 2>/dev/null)"
  vapid_public="$(printf '%s\n' "$vapid_private" | openssl ec -pubout -outform DER 2>/dev/null | tail -c 65 | base64 | tr -d '\n=' | tr '/+' '_-')"
  cat >"$CONFIG_DIR/stoat.env" <<EOF
REVOLT__RABBIT__PASSWORD=$(env_value RABBIT_PASSWORD)
REVOLT__FILES__S3__ACCESS_KEY_ID=roomsuploads
REVOLT__FILES__S3__SECRET_ACCESS_KEY=$(env_value MINIO_PASSWORD)
REVOLT__FILES__ENCRYPTION_KEY=$(openssl rand -base64 32)
REVOLT__PUSHD__VAPID__PRIVATE_KEY=$(printf '%s\n' "$vapid_private" | base64 | tr -d '\n=')
REVOLT__PUSHD__VAPID__PUBLIC_KEY=$vapid_public
EOF
  cat >"$CONFIG_DIR/Revolt.toml" <<EOF
production = true
environment = "production"

[database]
mongodb = "mongodb://rooms_stoat:$mongo_stoat@database:27017/?authSource=admin"

[hosts]
app = "https://$domain"
api = "https://$domain/api"
events = "wss://$domain/ws"
autumn = "https://$domain/autumn"
january = "https://$domain/january"
gifbox = "https://$domain/gifbox"

[api.registration]
invite_only = true
EOF
  printf '{"api":"https://%s/api"}\n' "$domain" >"$CONFIG_DIR/stoat.json"
  cat >"$CONFIG_DIR/livekit.yaml" <<EOF
port: 7880
rtc:
  tcp_port: 7881
  udp_port: 7882
  node_ip: $ip
  use_external_ip: false
keys:
  $livekit_key: $livekit_secret
webhook:
  api_key: $livekit_key
  urls:
    - http://access:3002/v1/media/webhook
EOF
  # Upstream Stoat images run as UID 65532; ROOMS services as UID 1000.
  chown 65532:65532 "$CONFIG_DIR/Revolt.toml" 2>/dev/null || chmod 644 "$CONFIG_DIR/Revolt.toml"
  chmod 644 "$CONFIG_DIR/stoat.json" "$CONFIG_DIR/livekit.yaml"
  chown 1000:1000 "$DATA_DIR/access" 2>/dev/null || chmod 777 "$DATA_DIR/access"
  ok "Yapılandırma oluşturuldu. Sırlar yalnızca bu sunucuda: $ENV_FILE"
}

server_image() {
  local image
  image="$(env_value ROOMS_SERVER_IMAGE)"
  if [[ -n "$image" ]] && compose pull --quiet access 2>/dev/null; then
    ok "ROOMS servis imajı indirildi: $image"
  else
    info "ROOMS servisleri kaynak koddan derleniyor (ilk seferde birkaç dakika sürebilir)..."
    compose build --build-arg ROOMS_SOURCE_SHA="$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo unknown)" access
  fi
}

wait_healthy() {
  info "Servislerin hazır olması bekleniyor..."
  for _ in $(seq 1 90); do
    if compose exec -T access node -e "fetch('http://127.0.0.1:3002/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))" 2>/dev/null &&
      compose exec -T access node -e "fetch('http://api:14702/').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))" 2>/dev/null; then
      ok "Servisler hazır."
      return 0
    fi
    sleep 2
  done
  die "Servisler 3 dakikada hazır olmadı. Kontrol: rooms logs"
}

cmd_up() {
  require_setup
  compose pull --quiet --ignore-buildable 2>/dev/null || compose pull --quiet --ignore-pull-failures || true
  server_image
  compose up -d --remove-orphans
  wait_healthy
}

cmd_bootstrap() {
  require_setup
  if compose run --rm -T --no-deps admin node admin.cjs status 2>/dev/null | grep -q '"bootstrapped": true'; then
    ok "Topluluk zaten kurulu. Davet için: rooms invite"
    return
  fi
  bold "Topluluk sahibi hesabı"
  info "Bu hesapla ROOMS uygulamasında giriş yapacaksın."
  local email username password password2 community
  email="${ROOMS_OWNER_EMAIL:-$(ask 'E-posta' "$(env_value ROOMS_ACME_EMAIL)")}"
  username="${ROOMS_OWNER_USERNAME:-$(ask 'Kullanıcı adı')}"
  community="${ROOMS_COMMUNITY_NAME:-$(ask 'Topluluk adı' 'Tayfa')}"
  if [[ -n "${ROOMS_OWNER_PASSWORD:-}" ]]; then
    password="$ROOMS_OWNER_PASSWORD"
  else
    read -r -s -p "  Parola (en az 8 karakter): " password </dev/tty
    echo
    read -r -s -p "  Parola (tekrar): " password2 </dev/tty
    echo
    [[ "$password" == "$password2" ]] || die "Parolalar eşleşmedi."
  fi
  # Details travel over stdin so the password never appears in process arguments.
  printf 'email=%s\npassword=%s\nusername=%s\ncommunityName=%s\n' \
    "$email" "$password" "$username" "$community" |
    compose run --rm -T --no-deps admin node admin.cjs bootstrap
  ok "Sahip hesabı hazır: $email"
}

cmd_invite() {
  require_setup
  compose run --rm -T --no-deps admin node admin.cjs invite "$@"
  info "Bağlantıyı yalnızca davet etmek istediğin kişilerle paylaş (varsayılan: 7 gün, 10 kişi)."
  info "Arkadaşın bağlantıyı açıp uygulamayı indirir; ROOMS'ta 'Kayıt ol' sekmesine yapıştırması da yeterli."
  info "Bağlantıları uygulamada Topluluk yönetimi → Davetler bölümünden iptal edebilirsin."
}

cmd_status() {
  require_setup
  compose ps --format 'table {{.Service}}\t{{.Status}}'
  echo
  local domain
  domain="$(env_value ROOMS_DOMAIN)"
  if curl -fsS --max-time 10 "https://$domain/rooms-access/health" >/dev/null 2>&1; then
    ok "https://$domain dışarıdan erişilebilir."
  else
    warn "https://$domain dışarıdan erişilemiyor (DNS, 80/443 portları veya sertifika)."
  fi
  compose run --rm -T --no-deps admin node admin.cjs status 2>/dev/null | grep -q '"bootstrapped": true' &&
    ok "Topluluk kurulu." || warn "Topluluk henüz kurulmadı: rooms bootstrap"
}

cmd_update() {
  require_setup
  local ref="${1:-main}"
  git -C "$REPO_DIR" fetch --tags --quiet origin
  info "Güncelleniyor: $ref"
  cmd_backup
  if git -C "$REPO_DIR" show-ref --verify --quiet "refs/remotes/origin/$ref"; then
    git -C "$REPO_DIR" checkout --quiet "$ref"
    git -C "$REPO_DIR" merge --ff-only --quiet "origin/$ref" ||
      die "Yerel değişiklikler güncellemeyi engelliyor: $REPO_DIR"
  else
    git -C "$REPO_DIR" checkout --quiet "$ref"
  fi
  cmd_up
  # The Caddyfile is a single-file bind mount; a restart picks up routes added by the update.
  compose restart caddy >/dev/null
  ok "Güncelleme tamamlandı ($(git -C "$REPO_DIR" rev-parse --short HEAD))."
}

cmd_backup() {
  require_setup
  local stamp out stage
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "$DEPLOY_DIR/backups"
  stage="$(mktemp -d "$DEPLOY_DIR/backups/.stage-XXXXXX")"
  out="$DEPLOY_DIR/backups/rooms-$stamp.tar.gz"
  info "Yedek alınıyor..."
  if ! {
    compose exec -T database sh -c 'mongodump --quiet --archive --gzip -u rooms_admin -p "$MONGO_INITDB_ROOT_PASSWORD" --authenticationDatabase admin' >"$stage/mongo.archive.gz" &&
      compose exec -T postgres pg_dump -U rooms_activity rooms >"$stage/activities.sql" &&
      tar -czf "$out" -C "$stage" mongo.archive.gz activities.sql \
        -C "$DEPLOY_DIR" .env config data/access data/minio
  }; then
    rm -rf "$stage" "$out"
    die "Yedek alınamadı. Servisler çalışıyor mu? rooms status"
  fi
  rm -rf "$stage"
  chmod 600 "$out"
  ok "Yedek: $out"
  info "Bu dosya parolaları ve mesajları içerir. Sunucu dışında güvenli bir yere kopyala."
}

cmd_firewall() {
  if command -v ufw >/dev/null; then
    ufw allow 22/tcp >/dev/null
    ufw allow 80/tcp >/dev/null
    ufw allow 443/tcp >/dev/null
    ufw allow 7881/tcp >/dev/null
    ufw allow 7882/udp >/dev/null
    ok "ufw kuralları eklendi (22, 80, 443, 7881/tcp, 7882/udp)."
  else
    info "ufw yok. Sağlayıcının güvenlik duvarında 80, 443, 7881/tcp ve 7882/udp açık olmalı."
  fi
}

usage() {
  cat <<EOF
Kullanım: rooms <komut>

  setup        Yapılandırmayı ve sırları oluştur (bir kez)
  up           Servisleri indir/derle ve başlat
  bootstrap    Sahip hesabını ve topluluğu oluştur (bir kez)
  invite       Davet bağlantısı üret  [--uses=1-50] [--days=1-7] [--count=N]
  status       Servis ve erişim durumunu göster
  logs [svc]   Günlükleri izle (örnek: rooms logs access)
  restart      Servisleri yeniden başlat
  stop         Servisleri durdur (veriler korunur)
  backup       Veritabanı ve dosyaların yedeğini al
  update [tag] Yedek alıp en son sürüme güncelle
  firewall     ufw ile gerekli portları aç
EOF
}

main() {
  [[ $EUID -eq 0 ]] || die "rooms komutunu root olarak çalıştır (sudo rooms ...)."
  local command="${1:-help}"
  shift || true
  case "$command" in
  setup) cmd_setup ;;
  up | start) cmd_up ;;
  bootstrap) cmd_bootstrap ;;
  invite) cmd_invite "$@" ;;
  status) cmd_status ;;
  logs) compose logs -f --tail=100 "$@" ;;
  restart) compose restart ;;
  stop) compose stop ;;
  backup) cmd_backup ;;
  update) cmd_update "$@" ;;
  firewall) cmd_firewall ;;
  compose) compose "$@" ;;
  help | -h | --help) usage ;;
  *)
    usage
    exit 2
    ;;
  esac
}

main "$@"
